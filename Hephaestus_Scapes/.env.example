# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
# 若你的 Supabase 專案仍只有舊版 key，也可暫時使用：
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ECPay
ECPAY_MERCHANT_ID=YOUR_MERCHANT_ID
ECPAY_HASH_KEY=YOUR_HASH_KEY
ECPAY_HASH_IV=YOUR_HASH_IV

# ECPay Logistics (C2C) - separate from payment credentials
ECPAY_LOGISTICS_MERCHANT_ID=3514353
ECPAY_LOGISTICS_HASH_KEY=YOUR_LOGISTICS_HASH_KEY
ECPAY_LOGISTICS_HASH_IV=YOUR_LOGISTICS_HASH_IV

# Website
PUBLIC_BASE_URL=https://hephaestusscapes.vercel.app
SITE_URL=https://hephaestusscapes.vercel.app

# Stage / Production
ECPAY_ENV=prod
ECPAY_LOGISTICS_ENV=stage
